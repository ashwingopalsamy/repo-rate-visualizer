{
  "name": "repo-rate-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:app": "node --test \"tests/app/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:data": "node --test tests/data/snapshotV2.test.js tests/data/rbiSources.test.js tests/data/supplementalHistory.test.js tests/data/releaseManifest.test.js",
    "test:hf-dataset": "python3 -m unittest tests/data/test_hf_dataset.py",
    "test:pipeline": "node --test \"tests/pipeline/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "validate:data": "node pipeline/publish.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  }
}
